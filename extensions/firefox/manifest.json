{
  "manifest_version": 3,
  "name": "IDM Enhanced",
  "version": "0.5.0",
  "description": "Explicitly queue HTTP(S) links in the IDM Enhanced desktop app.",
  "permissions": ["nativeMessaging", "contextMenus", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "idm-enhanced-dev@mahmoud-khedr.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
